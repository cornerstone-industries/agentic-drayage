# PortCall environment. Copy to .env.local for local dev; set the same names in Vercel.
# KEYS_TODO.md says where each value comes from and what to run after adding it.

# Supabase (Project Settings > API). Hosted project: portcall (Cornerstone org), ref apbvdeghnqrvagjdscog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude via Vercel AI Gateway (on Vercel deployments OIDC also works without a key)
AI_GATEWAY_API_KEY=
# Optional model overrides (AI Gateway slugs)
AI_EXTRACT_MODEL=anthropic/claude-haiku-4.5
AI_RECOMMEND_MODEL=anthropic/claude-sonnet-5.5

# Vapi outbound calls
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Any long random string; sent by Vapi as the x-webhook-secret header (set by npm run setup:vapi)
VAPI_WEBHOOK_SECRET=

# Stripe (TEST MODE ONLY: sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend tender email
RESEND_API_KEY=
TENDER_FROM_EMAIL=
# Optional: send every tender email here instead of the fictional provider address (demo inbox)
TENDER_EMAIL_OVERRIDE_TO=

# This deployment's public URL, no trailing slash (webhooks, tender links, replay)
APP_URL=
# Any long random string; pg_cron, Vercel Cron and the test scripts send it as x-internal-secret
INTERNAL_CRON_SECRET=

DEMURRAGE_PER_DAY_CENTS=17500
PLATFORM_FEE_BPS=300
CALL_MODE=live            # live | replay
# Seeded importer MCP key (npm run seed prints one; pin it here so re-seeds keep it)
DEMO_MCP_API_KEY=

# Replay pacing (1 = real time, 4 = four times faster)
REPLAY_SPEED=1
# DEV ONLY: deterministic fixture extraction/ranking when no AI Gateway key exists. Never in production.
DEV_ONLY_FIXTURE_AI=false

# Seed options
JUDGE_EMAIL=judge@portcall.dev
JUDGE_PASSWORD=portcall-judge-2026
# Teammates' phones for Marshgrass, Ironclad, Sweetgrass (E.164, comma separated)
DEMO_PROVIDER_PHONES=
